# 仅为变量说明。开发命令不会自动加载此文件；在终端 export 或使用 Node --env-file。
PORT=8080
# 本地留空可使用内置酒谱；production 模式必须填写真实 TCB 环境 ID。
CLOUD_BASE_ENV_ID=
# 按实际环境选择，不能将 AppID 当环境 ID。
TENCENTCLOUD_REGION=ap-shanghai
# CloudBase 普通容器不会自动注入数据库运行凭证；可配置本环境的服务端 API Key。
# 仅在平台环境变量/密钥中注入，不能放入小程序或 Git；不要使用 publish_key。
CLOUDBASE_APIKEY=
# 云托管优先使用已授权的运行身份，不填长期密钥。
# 如在本机执行 seed，可临时注入具备相应 TCB 权限的凭证；禁止提交真实值。
TENCENTCLOUD_SECRETID=
TENCENTCLOUD_SECRETKEY=
TENCENTCLOUD_SESSIONTOKEN=
# 只有确认平台移除客户端伪造的转发头且只有一个可信网关时才设为 1。
# 默认 0 不信任 X-Forwarded-For；此时共享出口可能共用请求额度。
TRUST_PROXY_HOPS=0
